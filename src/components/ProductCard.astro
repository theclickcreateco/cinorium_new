---
interface Props {
  title: string;
  headline?: string;
  image: string;
  amazonLink: string;
  bullets: string[];
  microReview?: string;
  itemNumber?: number;
}

const { title, headline, image, amazonLink, bullets, microReview, itemNumber } = Astro.props;
---

<article class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm space-y-6 max-w-md mx-auto my-4">
  
  <header class="space-y-1">
    <h2 class="text-xl font-semibold tracking-tight text-gray-900 leading-snug">
      {itemNumber && <span class="text-amber-600 mr-1">{itemNumber}.</span>} {title}
    </h2>
    {headline && <p class="text-sm text-gray-400 font-light italic">"{headline}"</p>}
  </header>

  <div class="bg-gray-50/60 text-center py-2 px-3 rounded-md border border-gray-100/50">
    <p class="text-[10px] text-gray-400 leading-tight">
      ✨ <strong class="text-gray-500 font-medium">Transparency Note:</strong> As an Amazon Associate, I earn from qualifying purchases at zero extra cost to you.
    </p>
  </div>

  <div class="relative aspect-square w-full bg-gray-50 rounded-xl border border-gray-100 overflow-hidden">
    
    {/* If images is passed as an array with multiple items, loop over them */}
    {Array.isArray(Astro.props.images) && Astro.props.images.length > 1 ? (
      <div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none h-full w-full">
        {Astro.props.images.map((imgUrl, index) => (
          <div class="w-full h-full flex-shrink-0 snap-start relative">
            <img 
              src={imgUrl} 
              alt={`${title} view ${index + 1}`} 
              class="w-full h-full object-cover"
              loading={index === 0 ? "eager" : "lazy"} 
            />
            {/* Visual Indicator Pill for Users */}
            <span class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm text-white font-medium text-[9px] tracking-wider px-2 py-0.5 rounded-full select-none">
              {index + 1} / {Astro.props.images.length}
            </span>
          </div>
        ))}
      </div>
    ) : (
      /* Fallback for old posts that only provide a single string image variable */
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover"
        loading="lazy" 
      />
    )}
  </div>

  <div class="space-y-3">
    <h3 class="text-[11px] font-semibold tracking-wider uppercase text-gray-400">Why it fits the aesthetic:</h3>
    <ul class="space-y-2.5 text-sm text-gray-600 font-light pl-1">
      {bullets.map(bullet => (
        <li class="flex items-start">
          <span class="text-amber-500/80 mr-2.5 select-none text-xs mt-0.5">✦</span>
          <span class="leading-relaxed">{bullet}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="pt-2">
    <a 
      href={amazonLink} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center justify-center w-full bg-[#FF9900] text-black font-semibold tracking-wide text-xs uppercase py-4 px-4 rounded-xl shadow-md hover:bg-[#e68a00] transition active:scale-[0.98] duration-150"
    >
      <span class="mr-2 text-sm">🛒</span> CHECK PRICE ON AMAZON
    </a>

    <button 
      data-link={amazonLink}
      class="share-button w-full text-center text-[10px] text-gray-400 hover:text-gray-600 transition tracking-wide uppercase font-medium mt-3 block py-1"
    >
      🔗 Copy Direct Product Link
    </button>
  </div>

  <div class="border-t border-gray-100 pt-4 space-y-3">
    <div class="flex items-center justify-between text-[11px]">
      <span class="text-emerald-600 font-medium flex items-center">
        <span class="mr-1">✓</span> Eligible for Fast Prime Shipping
      </span>
      <div class="text-amber-400 font-medium tracking-tight">★★★★★</div>
    </div>
    
    {microReview && (
      <div class="bg-gray-50/50 border border-dashed border-gray-200/60 p-3 rounded-lg text-xs text-gray-500 font-light leading-relaxed">
        <strong class="text-gray-700 font-medium not-italic block mb-0.5">What shoppers love:</strong> 
        "{microReview}"
      </div>
    )}
  </div>

</article>

<script>
  // Script executes securely on client browser window
  const buttons = document.querySelectorAll('.share-button');
  
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const link = button.getAttribute('data-link');
      if (link) {
        navigator.clipboard.writeText(link);
        
        const originalText = button.innerHTML;
        button.innerHTML = "✅ Link Copied!";
        setTimeout(() => {
          button.innerHTML = originalText;
        }, 2000);
      }
    });
  });
</script>