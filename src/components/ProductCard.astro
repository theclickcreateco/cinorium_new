---
interface Props {
  title: string;
  headline?: string;
  image: string;
  amazonLink: string;
  bullets: string[];
  microReview?: string;
  itemNumber?: number;
}

const { title, headline, image, amazonLink, bullets, microReview, itemNumber } = Astro.props;
---

<article class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm space-y-6 max-w-md mx-auto my-4">
  
  <header class="space-y-1">
    <h2 class="text-xl font-semibold tracking-tight text-gray-900 leading-snug">
      {itemNumber && <span class="text-amber-600 mr-1">{itemNumber}.</span>} {title}
    </h2>
    {headline && <p class="text-sm text-gray-400 font-light italic">"{headline}"</p>}
  </header>

  <div class="bg-gray-50/60 text-center py-2 px-3 rounded-md border border-gray-100/50">
    <p class="text-[10px] text-gray-400 leading-tight">
      ✨ <strong class="text-gray-500 font-medium">Transparency Note:</strong> As an Amazon Associate, I earn from qualifying purchases at zero extra cost to you.
    </p>
  </div>

  <div class="relative aspect-square w-full bg-gray-50 rounded-xl border border-gray-100 overflow-hidden group/carousel">
    
    {Array.isArray(Astro.props.images) && Astro.props.images.length > 1 ? (
      <>
        <div 
          id={`carousel-${title.replace(/\s+/g, '-').toLowerCase()}`}
          class="carousel-container flex overflow-x-auto snap-x snap-mandatory scrollbar-none h-full w-full scroll-smooth"
        >
          {Astro.props.images.map((imgUrl, index) => (
            <div class="w-full h-full flex-shrink-0 snap-start relative">
              <img 
                src={imgUrl} 
                alt={`${title} view ${index + 1}`} 
                class="w-full h-full object-cover"
                loading={index === 0 ? "eager" : "lazy"} 
              />
            </div>
          ))}
        </div>

        <button 
          class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 bg-white/80 backdrop-blur-sm hover:bg-white text-gray-800 p-2 rounded-full shadow-sm opacity-0 group-hover/carousel:opacity-100 transition hidden md:flex items-center justify-center w-8 h-8 z-10 text-xs font-bold"
          aria-label="Previous image"
        >
          &larr;
        </button>
        <button 
          class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 bg-white/80 backdrop-blur-sm hover:bg-white text-gray-800 p-2 rounded-full shadow-sm opacity-0 group-hover/carousel:opacity-100 transition hidden md:flex items-center justify-center w-8 h-8 z-10 text-xs font-bold"
          aria-label="Next image"
        >
          &rarr;
        </button>

        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-black/60 backdrop-blur-sm text-white font-medium text-[9px] tracking-widest px-2.5 py-1 rounded-full select-none z-10">
          <span class="carousel-index">1</span> / {Astro.props.images.length}
        </div>
      </>
    ) : (
      /* Fallback for single image strings */
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover"
        loading="lazy" 
      />
    )}
  </div>

  <div class="space-y-3">
    <h3 class="text-[11px] font-semibold tracking-wider uppercase text-gray-400">Why it fits the aesthetic:</h3>
    <ul class="space-y-2.5 text-sm text-gray-600 font-light pl-1">
      {bullets.map(bullet => (
        <li class="flex items-start">
          <span class="text-amber-500/80 mr-2.5 select-none text-xs mt-0.5">✦</span>
          <span class="leading-relaxed">{bullet}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="pt-2">
    <a 
      href={amazonLink} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="flex items-center justify-center w-full bg-[#FF9900] text-black font-semibold tracking-wide text-xs uppercase py-4 px-4 rounded-xl shadow-md hover:bg-[#e68a00] transition active:scale-[0.98] duration-150"
    >
      <span class="mr-2 text-sm">🛒</span> CHECK PRICE ON AMAZON
    </a>

    <button 
      data-link={amazonLink}
      class="share-button w-full text-center text-[10px] text-gray-400 hover:text-gray-600 transition tracking-wide uppercase font-medium mt-3 block py-1"
    >
      🔗 Copy Direct Product Link
    </button>
  </div>

  <div class="border-t border-gray-100 pt-4 space-y-3">
    <div class="flex items-center justify-between text-[11px]">
      <span class="text-emerald-600 font-medium flex items-center">
        <span class="mr-1">✓</span> Eligible for Fast Prime Shipping
      </span>
      <div class="text-amber-400 font-medium tracking-tight">★★★★★</div>
    </div>
    
    {microReview && (
      <div class="bg-gray-50/50 border border-dashed border-gray-200/60 p-3 rounded-lg text-xs text-gray-500 font-light leading-relaxed">
        <strong class="text-gray-700 font-medium not-italic block mb-0.5">What shoppers love:</strong> 
        "{microReview}"
      </div>
    )}
  </div>

</article>

<script>
  // --- 1. EXISTING COPY LINK LOGIC ---
  const shareButtons = document.querySelectorAll('.share-button');
  shareButtons.forEach(button => {
    button.addEventListener('click', () => {
      const link = button.getAttribute('data-link');
      if (link) {
        navigator.clipboard.writeText(link);
        const originalText = button.innerHTML;
        button.innerHTML = "✅ Link Copied!";
        setTimeout(() => button.innerHTML = originalText, 2000);
      }
    });
  });

  // --- 2. NEW: DESKTOP DESKTOP NAVIGATION & SLIDE TRACKER LOGIC ---
  const carousels = document.querySelectorAll('.group\\/carousel');
  
  carousels.forEach(wrapper => {
    const container = wrapper.querySelector('.carousel-container') as HTMLElement;
    const prevBtn = wrapper.querySelector('.carousel-prev');
    const nextBtn = wrapper.querySelector('.carousel-next');
    const indexDisplay = wrapper.querySelector('.carousel-index');
    
    if (!container || !indexDisplay) return;

    // Arrow Clicking Logic
    if (nextBtn && prevBtn) {
      nextBtn.addEventListener('click', () => {
        container.scrollLeft += container.offsetWidth;
      });
      prevBtn.addEventListener('click', () => {
        container.scrollLeft -= container.offsetWidth;
      });
    }

    // Dynamic Index Number Tracking on Scroll or Click
    container.addEventListener('scroll', () => {
      const slideWidth = container.offsetWidth;
      const currentSlide = Math.round(container.scrollLeft / slideWidth) + 1;
      indexDisplay.textContent = currentSlide.toString();
    });
  });
</script>